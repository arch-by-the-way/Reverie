{
  "manifest_version": 3,
  "name": "Instant Site Summary",
  "version": "0.1.0",
  "description": "One-click summary of the page you're on.",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "src/background/index.js"
  },
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-script/index.js"]
    }
  ]
}