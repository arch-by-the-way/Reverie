{
  "manifest_version": 3,
  "name": "Instant Site Summary",
  "version": "0.1.0",
  "description": "One-click summary of the page you're on.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://YOUR-BACKEND-DOMAIN-HERE/*"],
  "background": {
    "service_worker": "src/background/index.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "instant-summary@reveriehacks.dev",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-script/index.js"]
    }
  ]
}